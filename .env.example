# Copilot SDK
# Either sign in via `npx copilot` (uses stored OAuth) or set a token:
# COPILOT_GITHUB_TOKEN=

# Microsoft Graph (Teams transcript fetch)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# GitHub publisher (optional)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PATH_PREFIX=docs/brd

# Workflow config
PDLC_MODEL=claude-sonnet-4.5
PDLC_MAX_GRILL_ROUNDS=6
PDLC_REDACT_PII=false

# API server
PORT=4000
