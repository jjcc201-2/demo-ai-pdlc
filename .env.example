# [Required] Copilot SDK
# Either sign in via `npx copilot` (uses stored OAuth) or set a token:
# COPILOT_GITHUB_TOKEN=

# [Optional] Microsoft Graph (Teams transcript fetch)
#GRAPH_TENANT_ID=
#GRAPH_CLIENT_ID=
#GRAPH_CLIENT_SECRET=


# [Optional] GitHub Publisher
#GITHUB_TOKEN=
#GITHUB_OWNER=
#GITHUB_REPO=
#GITHUB_BRANCH=main
#GITHUB_PATH_PREFIX=docs/brd

# [Optional] Azure DevOps Integration
# Local dev auth: relies on `az login` via DefaultAzureCredential.
# Production auth: set AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET
# for a service principal, or rely on managed identity when deployed to Azure.
# PDLC_ADO_ORG=
# PDLC_ADO_DEFAULT_PROJECT=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# API access control (defence-in-depth)
# Origins allowed to call the API from a browser (comma-separated). Defaults to
# http://localhost:3000 when unset. Non-browser callers (no Origin header) are
# always allowed.
# PDLC_ALLOWED_ORIGINS=http://localhost:3000
# Optional bearer token required on non-GET requests. When set, all mutating
# calls must include Authorization: Bearer <token>. The web UI reads
# NEXT_PUBLIC_API_TOKEN and forwards it automatically.
# PDLC_API_TOKEN=
# NEXT_PUBLIC_API_TOKEN=

# Workflow config
PDLC_MODEL=claude-sonnet-4.5
PDLC_MAX_GRILL_ROUNDS=4
PDLC_REDACT_PII=false

# API server
PORT=4000
