{
  "name": "pdlc",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted product development lifecycle workflow using the GitHub Copilot SDK.",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build && pnpm -r --filter \"./apps/*\" run build",
    "dev-api": "pnpm --filter @pdlc/api run dev",
    "dev-web": "pnpm --filter @pdlc/web run dev",
    "dev:api": "pnpm --filter @pdlc/api run dev",
    "dev:web": "pnpm --filter @pdlc/web run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "cli": "pnpm --filter @pdlc/api run cli",
    "run:cli": "pnpm --filter @pdlc/api run cli"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
